# Copy to .env and fill in.

# --- Postgres (n8n's database) ---
POSTGRES_USER=n8n
POSTGRES_PASSWORD=change-me
POSTGRES_DB=n8n

# --- n8n ---
# Generate with: openssl rand -hex 32   (never change it after first start)
N8N_ENCRYPTION_KEY=replace-with-a-long-random-string
N8N_HOST=localhost
N8N_PROTOCOL=http
# Telegram needs a public HTTPS URL for its webhook. For local dev use a tunnel, e.g.
#   cloudflared tunnel --url http://localhost:5678   or   ngrok http 5678
# and put the https URL here (with trailing slash).
WEBHOOK_URL=http://localhost:5678/
GENERIC_TIMEZONE=Asia/Kolkata
