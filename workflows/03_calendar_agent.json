{
  "id": "SwarmCalendar001",
  "name": "SwarmAI - Calendar Agent",
  "active": false,
  "settings": { "executionOrder": "v1", "callerPolicy": "workflowsFromSameOwner" },
  "nodes": [
    {
      "id": "c0000001-0000-4000-8000-000000000001",
      "name": "When Called by Master",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [0, 0],
      "parameters": {
        "workflowInputs": { "values": [{ "name": "query" }, { "name": "sessionId" }] }
      }
    },
    {
      "id": "c0000001-0000-4000-8000-000000000002",
      "name": "Calendar Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [260, 0],
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.query }}",
        "options": {
          "systemMessage": "=You are the CALENDAR AGENT of a personal assistant. Current time: {{ $now.toISO() }} (timezone {{ $now.zoneName }}).\n\nYou manage the user's primary Google Calendar: list events, create events, update events, delete events.\n\nRules:\n- Resolve relative dates ('tomorrow 3pm', 'next Monday') against the current time and use ISO 8601 with timezone offset.\n- Default meeting length is 30 minutes when no end time is given.\n- Before creating an event, check that time range for conflicts and mention any clash.\n- To update or delete, first list events to find the event ID. Never delete if more than one event matches; ask which one.\n- Report what you did with title, date, start and end time."
        }
      }
    },
    {
      "id": "c0000001-0000-4000-8000-000000000003",
      "name": "OpenAI Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.2,
      "position": [80, 240],
      "parameters": {
        "model": { "__rl": true, "mode": "list", "value": "gpt-4o-mini" },
        "options": { "temperature": 0.1 }
      }
    },
    {
      "id": "c0000001-0000-4000-8000-000000000004",
      "name": "Get Events",
      "type": "n8n-nodes-base.googleCalendarTool",
      "typeVersion": 1.3,
      "position": [260, 240],
      "parameters": {
        "descriptionType": "manual",
        "toolDescription": "List calendar events between two datetimes. Returns id, summary, start, end, location.",
        "operation": "getAll",
        "calendar": { "__rl": true, "mode": "list", "value": "primary" },
        "returnAll": false,
        "limit": 25,
        "timeMin": "={{ $fromAI('time_min', 'Start of range, ISO 8601', 'string') }}",
        "timeMax": "={{ $fromAI('time_max', 'End of range, ISO 8601', 'string') }}",
        "options": { "orderBy": "startTime", "singleEvents": true }
      }
    },
    {
      "id": "c0000001-0000-4000-8000-000000000005",
      "name": "Create Event",
      "type": "n8n-nodes-base.googleCalendarTool",
      "typeVersion": 1.3,
      "position": [440, 240],
      "parameters": {
        "descriptionType": "manual",
        "toolDescription": "Create a new calendar event.",
        "calendar": { "__rl": true, "mode": "list", "value": "primary" },
        "start": "={{ $fromAI('start', 'Event start, ISO 8601', 'string') }}",
        "end": "={{ $fromAI('end', 'Event end, ISO 8601', 'string') }}",
        "additionalFields": {
          "summary": "={{ $fromAI('title', 'Event title', 'string') }}",
          "description": "={{ $fromAI('description', 'Event description, may be empty', 'string') }}",
          "location": "={{ $fromAI('location', 'Event location, may be empty', 'string') }}"
        }
      }
    },
    {
      "id": "c0000001-0000-4000-8000-000000000006",
      "name": "Update Event",
      "type": "n8n-nodes-base.googleCalendarTool",
      "typeVersion": 1.3,
      "position": [620, 240],
      "parameters": {
        "descriptionType": "manual",
        "toolDescription": "Reschedule or rename an existing event by its ID.",
        "operation": "update",
        "calendar": { "__rl": true, "mode": "list", "value": "primary" },
        "eventId": "={{ $fromAI('event_id', 'ID of the event to update', 'string') }}",
        "updateFields": {
          "start": "={{ $fromAI('start', 'New start, ISO 8601', 'string') }}",
          "end": "={{ $fromAI('end', 'New end, ISO 8601', 'string') }}",
          "summary": "={{ $fromAI('title', 'New (or unchanged) event title', 'string') }}"
        }
      }
    },
    {
      "id": "c0000001-0000-4000-8000-000000000007",
      "name": "Delete Event",
      "type": "n8n-nodes-base.googleCalendarTool",
      "typeVersion": 1.3,
      "position": [800, 240],
      "parameters": {
        "descriptionType": "manual",
        "toolDescription": "Delete a calendar event by its ID.",
        "operation": "delete",
        "calendar": { "__rl": true, "mode": "list", "value": "primary" },
        "eventId": "={{ $fromAI('event_id', 'ID of the event to delete', 'string') }}",
        "options": {}
      }
    }
  ],
  "connections": {
    "When Called by Master": { "main": [[{ "node": "Calendar Agent", "type": "main", "index": 0 }]] },
    "OpenAI Chat Model": { "ai_languageModel": [[{ "node": "Calendar Agent", "type": "ai_languageModel", "index": 0 }]] },
    "Get Events": { "ai_tool": [[{ "node": "Calendar Agent", "type": "ai_tool", "index": 0 }]] },
    "Create Event": { "ai_tool": [[{ "node": "Calendar Agent", "type": "ai_tool", "index": 0 }]] },
    "Update Event": { "ai_tool": [[{ "node": "Calendar Agent", "type": "ai_tool", "index": 0 }]] },
    "Delete Event": { "ai_tool": [[{ "node": "Calendar Agent", "type": "ai_tool", "index": 0 }]] }
  }
}
