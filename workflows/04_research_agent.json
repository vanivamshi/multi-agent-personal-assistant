{
  "id": "SwarmResearch001",
  "name": "SwarmAI - Research Agent",
  "active": false,
  "settings": { "executionOrder": "v1", "callerPolicy": "workflowsFromSameOwner" },
  "nodes": [
    {
      "id": "b0000001-0000-4000-8000-000000000001",
      "name": "When Called by Master",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [0, 0],
      "parameters": {
        "workflowInputs": { "values": [{ "name": "query" }, { "name": "sessionId" }] }
      }
    },
    {
      "id": "b0000001-0000-4000-8000-000000000002",
      "name": "Research Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [260, 0],
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.query }}",
        "options": {
          "systemMessage": "=You are the RESEARCH AGENT of a personal assistant. Current date: {{ $now.toISODate() }}.\n\nWorkflow: search -> gather -> summarise.\n- Use Google Search (SerpAPI) for current facts, news, prices, people, places.\n- Use Wikipedia for background / encyclopedic context.\n- Run several searches if the first result is thin.\n\nAnswer format:\n- A short direct answer first.\n- Then 3-6 key bullet points.\n- Then 'Sources:' with the URLs you relied on.\nNever invent facts or URLs. If sources disagree, say so."
        }
      }
    },
    {
      "id": "b0000001-0000-4000-8000-000000000003",
      "name": "Gemini Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1,
      "position": [80, 240],
      "parameters": {
        "modelName": "models/gemini-2.5-flash",
        "options": { "temperature": 0.3 }
      }
    },
    {
      "id": "b0000001-0000-4000-8000-000000000004",
      "name": "Google Search",
      "type": "@n8n/n8n-nodes-langchain.toolSerpApi",
      "typeVersion": 1,
      "position": [280, 240],
      "parameters": { "options": {} }
    },
    {
      "id": "b0000001-0000-4000-8000-000000000005",
      "name": "Wikipedia",
      "type": "@n8n/n8n-nodes-langchain.toolWikipedia",
      "typeVersion": 1,
      "position": [460, 240],
      "parameters": {}
    }
  ],
  "connections": {
    "When Called by Master": { "main": [[{ "node": "Research Agent", "type": "main", "index": 0 }]] },
    "Gemini Chat Model": { "ai_languageModel": [[{ "node": "Research Agent", "type": "ai_languageModel", "index": 0 }]] },
    "Google Search": { "ai_tool": [[{ "node": "Research Agent", "type": "ai_tool", "index": 0 }]] },
    "Wikipedia": { "ai_tool": [[{ "node": "Research Agent", "type": "ai_tool", "index": 0 }]] }
  }
}
